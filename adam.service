[Unit]
Description=Adam Virtual Receptionist
After=network.target ollama.service sound.target alsa-restore.service
Wants=ollama.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
SupplementaryGroups=audio
WorkingDirectory=/home/ubuntu/Adam
EnvironmentFile=/home/ubuntu/Adam/.env
ExecStartPre=/bin/bash -c 'until aplay -l 2>/dev/null | grep -q "USB PnP Audio Device"; do echo "Waiting for USB audio device..."; sleep 2; done'
ExecStartPre=/bin/bash -c 'until curl -sf http://127.0.0.1:11434/api/tags > /dev/null; do echo "Waiting for Ollama..."; sleep 3; done'
ExecStart=/home/ubuntu/Adam/.venv/bin/assistant --voice
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=adam

[Install]
WantedBy=multi-user.target
